<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>goofy_bringup</name>
  <version>2.0.0</version>
  <description>The single launch file that brings up the whole goofy stack on the Pi: robot description, motor bridge, RPLIDAR, and SLAM.</description>
  <maintainer email="josephinegangmei03@gmail.com">Josephine</maintainer>
  <license>MIT</license>

  <exec_depend>goofy_description</exec_depend>
  <exec_depend>goofy_motor_bridge</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
