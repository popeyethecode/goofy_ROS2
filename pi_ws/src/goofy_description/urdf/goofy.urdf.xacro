<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="goofy">

  <material name="grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="green">
    <color rgba="0 0.6 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ============================================================
       DIMENSIONS - measure your actual chassis and edit here.
       wheel_radius / wheel_y (half the wheel-separation) MUST match
       goofy_motor_bridge/config/motor_bridge_params.yaml
       (wheel_radius, wheel_separation = 2 * wheel_y) or odometry and
       the visual model will disagree.
       ============================================================ -->
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <xacro:property name="base_length" value="0.20"/>
  <xacro:property name="base_width" value="0.14"/>
  <xacro:property name="base_height" value="0.06"/>
  <xacro:property name="base_z" value="0.03"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_z" value="0.075"/>

  <xacro:property name="wheel_x" value="-0.05"/>
  <xacro:property name="wheel_y" value="0.085"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_x" value="0.06"/>
  <xacro:property name="caster_z" value="-0.02"/>

  <xacro:property name="base_mass" value="2.0"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="lidar_mass" value="0.1"/>
  <!-- Not originally defined - needed a mass value for caster inertia -->
  <xacro:property name="caster_mass" value="0.05"/>

  <!-- Realistic-ish joint dynamics for the driven wheels. Harmless for a
       real robot (motor_bridge drives PWM directly, it doesn't read
       these), but means the model is ready to drop into ros2_control /
       Gazebo later without silently having zero friction/damping. -->
  <xacro:property name="wheel_damping" value="0.1"/>
  <xacro:property name="wheel_friction" value="0.05"/>

  <xacro:macro name="box_inertia" params="mass length width height *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (width*width + height*height)}" ixy="0" ixz="0"
        iyy="${(1/12) * mass * (length*length + height*height)}" iyz="0"
        izz="${(1/12) * mass * (length*length + width*width)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0" ixz="0"
        iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0"
        izz="${0.5 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2/5) * mass * radius*radius}" ixy="0" ixz="0"
        iyy="${(2/5) * mass * radius*radius}" iyz="0"
        izz="${(2/5) * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="wheel" params="name color">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="${color}"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </xacro:cylinder_inertia>
    </link>
  </xacro:macro>


  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertia mass="${base_mass}" length="${base_length}" width="${base_width}" height="${base_height}">
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>


  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <xacro:cylinder_inertia mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>
  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>
  <xacro:wheel name="left_wheel" color="green"/>
  <xacro:wheel name="right_wheel" color="green"/>

  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_x} ${wheel_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="${wheel_damping}" friction="${wheel_friction}"/>
  </joint>
  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_x} -${wheel_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="${wheel_damping}" friction="${wheel_friction}"/>
  </joint>
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <xacro:sphere_inertia mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </xacro:sphere_inertia>
  </link>
  <joint name="base_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

    <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

</robot>
